# OSSZ ATELIER — production .htaccess (Namecheap / LiteSpeed / CloudLinux)
#
# 1. Pin the subdomain to CloudLinux alt-php 8.2 (PHP 8.2.35 with mbstring,
#    dom, fileinfo, pdo_mysql, zip). The server default for new vhosts is
#    PHP 7.2 and alt-php84 lacks mbstring/dom — never remove this directive.
AddHandler application/x-httpd-alt-php82___lsphp .php

# 2. Force HTTPS (a valid Let's Encrypt certificate is installed).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. Standard Laravel front controller.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not a Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# 4. Security hardening (defence in depth; Laravel also sends its own
#    response headers via App\Http\Middleware\SecurityHeaders).
<IfModule mod_headers.c>
    # Hide the PHP version banner from responses.
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# 5. Never serve dotfiles, env files, logs, backups or dumps even if one
#    is accidentally copied into the webroot (the app lives one level
#    above, but this guards against operational mistakes).
<FilesMatch "(^\.|\.(env|log|sql|bak|old|ini|lock|md|ya?ml|dist|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
