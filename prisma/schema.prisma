// OSSZ ATELIER — Independent Production Management System
// Completely standalone database: staff accounts, authentication, manually
// registered customers & orders, production tasks with configurable checklist
// stages, quality control, notifications, staff performance and incentives.
//
// Enum-like values (roles, statuses, states) are stored as strings and
// validated in the application layer for portability (SQLite -> MySQL/MariaDB).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts, roles & authentication (MANAGEMENT | ADMIN | STAFF)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  jobTitle     String?
  passwordHash String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks ProductionTask[] @relation("TaskAssignee")

  @@index([role, isActive])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Customers & manually registered orders
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique // CUST-0001
  name        String
  phone       String
  email       String?
  address     String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([name])
}

model Order {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique // manually entered business reference
  customerId           String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  description          String
  garmentCategory      String
  numberOfPieces       Int       @default(1)
  instructions         String?
  priority             String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  notes                String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  tasks    ProductionTask[]

  @@index([customerId])
  @@index([orderDate])
  @@index([priority])
}

// ---------------------------------------------------------------------------
// Production tasks (one garment piece / activity per task)
// status: UNASSIGNED | ASSIGNED | ONGOING | AWAITING_INSPECTION |
//         CHANGES_REQUESTED | APPROVED | READY_FOR_PICKUP | DELIVERED |
//         BLOCKED | CANCELLED
// ---------------------------------------------------------------------------

model ProductionTask {
  id            String    @id @default(cuid())
  code          String    @unique // TASK-0001 (system generated)
  orderId       String
  garmentPiece  String
  category      String    @default("FULL") // FULL | CUTTING | SEWING | FINISHING | IRONING | OTHER
  instructions  String?
  deadline      DateTime?
  priority      String    @default("NORMAL")
  status        String    @default("UNASSIGNED")
  progress      Int       @default(0) // 0-100
  assignedStaffId String?
  cancelReason  String?
  blockedReason String?
  completedAt   DateTime?
  deliveredAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order          @relation(fields: [orderId], references: [id])
  assignedStaff User?          @relation("TaskAssignee", fields: [assignedStaffId], references: [id])

  @@index([orderId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([deadline])
  @@index([updatedAt])
}

/// Assignment & reassignment history (immutable).
model TaskAssignment {
  id             String   @id @default(cuid())
  taskId         String
  staffId        String
  staffName      String
  assignedById   String
  assignedByName String
  type           String   // ASSIGN | REASSIGN | UNASSIGN
  note           String?
  createdAt      DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([staffId, createdAt])
}

// ---------------------------------------------------------------------------
// Configurable production checklist stages
// ---------------------------------------------------------------------------

/// A workflow stage. `appliesTo` is "ALL" or a comma-separated list of task
/// categories (e.g. "FULL,CUTTING"). Weight drives progress calculation.
model ProductionStage {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  weight    Float    @default(1)
  appliesTo String   @default("ALL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Current state of a stage for a task (NOT_STARTED | IN_PROGRESS | COMPLETED | NOT_APPLICABLE).
model TaskStageState {
  id             String   @id @default(cuid())
  taskId         String
  stageId        String
  state          String   @default("NOT_STARTED")
  updatedById    String?
  updatedByName  String?
  updatedAt      DateTime @updatedAt

  @@unique([taskId, stageId])
  @@index([taskId])
}

/// Immutable record of every stage status change.
model TaskStageUpdate {
  id            String   @id @default(cuid())
  taskId        String
  stageId       String
  stageName     String
  userId        String
  userName      String
  previousState String
  newState      String
  comment       String?
  createdAt     DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Immutable numerical progress history (append-only).
model TaskProgressHistory {
  id               String   @id @default(cuid())
  taskId           String
  userId           String
  userName         String
  previousProgress Int
  newProgress      Int
  source           String   @default("MANUAL") // MANUAL | STAGE | INSPECTION
  note             String?
  createdAt        DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

/// Immutable status workflow history.
model TaskStatusChange {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  userName   String
  fromStatus String
  toStatus   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([toStatus, createdAt])
}

// ---------------------------------------------------------------------------
// Quality control
// decision: APPROVED | CHANGES_REQUESTED | REOPENED
// ---------------------------------------------------------------------------

model InspectionRecord {
  id            String   @id @default(cuid())
  taskId        String
  inspectorId   String
  inspectorName String
  decision      String
  comments      String?
  createdAt     DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([inspectorId, createdAt])
}

/// Production notes & reported issues.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String
  message   String
  isIssue   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([isIssue, createdAt])
}

// ---------------------------------------------------------------------------
// Internal notifications
// type: TASK_ASSIGNED | TASK_REASSIGNED | DEADLINE_CHANGED | NEW_INSTRUCTIONS |
//   CORRECTIONS_REQUESTED | BLOCK_RESOLVED | TASK_APPROVED | TASK_REOPENED |
//   SUBMITTED_FOR_INSPECTION | TASK_OVERDUE | ISSUE_REPORTED | TASK_BLOCKED |
//   READY_FOR_PICKUP | TASK_DELIVERED
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?
  taskId    String?
  orderId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([type, taskId])
}

// ---------------------------------------------------------------------------
// Staff performance & incentives
// ---------------------------------------------------------------------------

/// Single global scoring configuration (weights must total 100).
model PerformanceConfig {
  id                 String   @id @default("main")
  productivityWeight Float    @default(30)
  timelyWeight       Float    @default(25)
  qualityWeight      Float    @default(30)
  reliabilityWeight  Float    @default(10)
  managementWeight   Float    @default(5)
  pieceTarget        Int      @default(20) // pieces/month for 100% productivity
  updatedAt          DateTime @updatedAt
}

/// Manual Management assessment input (0-100) per staff member per period.
/// period: "2026-11" (month) | "2026-Q4" (quarter) | "2026" (year)
model StaffAssessment {
  id        String   @id @default(cuid())
  staffId   String
  staffName String
  period    String
  score     Float    @default(0)
  comments  String?
  updatedAt DateTime @updatedAt

  @@unique([staffId, period])
}

/// periodType: MONTHLY | QUARTERLY | ANNUAL | QUALITY | ON_TIME | CUSTOM
model IncentiveScheme {
  id          String   @id @default(cuid())
  name        String
  periodType  String
  minScore    Float?
  amount      Float? // FCFA
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdByName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// status: PENDING | APPROVED | REJECTED ; paymentStatus: UNPAID | PAID
model IncentiveRecord {
  id               String    @id @default(cuid())
  schemeId         String
  schemeName       String
  staffId          String
  staffName        String
  period           String
  performanceScore Float
  eligible         Boolean
  proposedAmount   Float
  approvedAmount   Float?
  status           String    @default("PENDING")
  approvedById     String?
  approvedByName   String?
  approvalComments String?
  managementComments String?
  paymentStatus    String    @default("UNPAID")
  paymentDate      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([schemeId, staffId, period])
  @@index([staffId])
  @@index([period])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Permanent audit trail (Management-only visibility)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String?
  entityId   String?
  details    String? // JSON
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}
